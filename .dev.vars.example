# Copy to .dev.vars (wrangler preview) and .env.local (next dev). Never commit real values.
# Leave the Stripe keys empty to use the simulated checkout. It runs under next dev, or anywhere ALLOW_TEST_CHECKOUT=true
# (set that in .dev.vars for wrangler preview). In production without Stripe keys, booking is switched off.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ALLOW_TEST_CHECKOUT=true
# Paid bookings go straight onto the schedule. Set to true to hold them for review in /admin/sponsors first.
REVIEW_BOOKINGS=false
ADMIN_TOKEN=change-me-to-a-long-random-string
SITE_URL=http://localhost:3417
# Optional: /admin/stats reads Workers Analytics Engine with these (see ANALYTICS.md).
CF_ACCOUNT_ID=
CF_ANALYTICS_TOKEN=
